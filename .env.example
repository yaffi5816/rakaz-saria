# Copy to .env. Never commit the real file - .gitignore already excludes it.

# The API version needs a key from the Claude Console, exported in the terminal:
#   export ANTHROPIC_API_KEY=sk-ant-...
# The SDK version needs it NOT to be set, so that the run bills the Claude Code
# login instead of the key. SDK/main.py refuses to start if it finds one.

# Which workspace the agent acts on.
#   local - the seeded SQLite copy. The default, and what every measured run and
#           every test uses, because a run has to start from a clean state.
#   http  - a running instance of the task application, for the live demo only.
RAKAZ_WORKSPACE=local
RAKAZ_API_BASE=http://localhost:8000
RAKAZ_API_USER=sarah.avital

# The agent acts as this person and sees exactly what they see.
RAKAZ_ACTOR=sarah.avital

# Frozen so two runs of the same scenario produce the same lateness, the same
# "next working day" and therefore comparable numbers.
RAKAZ_TODAY=2026-10-26
