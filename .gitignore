__pycache__/
*.pyc
.venv/
.env

# Runtime state. Rebuilt from shared/fixtures at the start of every run, so a
# committed copy would only ever be one run's leftovers.
state/

# What the agent learned. memory/profile.md IS committed - it is the briefing
# both versions start from - but the conventions file is written during a run
# and reset before the next one.
memory/conventions.jsonl

# Transcripts produced from a recording. The .vtt sits beside the audio as a
# cache so the same meeting is never transcribed twice; it is derived, and a
# committed copy would go stale the moment the recording is replaced.
*.m4a.vtt
*.mp3.vtt
*.wav.vtt
*.opus.vtt
*.ogg.vtt

# results/ is committed on purpose: api.json and sdk.json are the deliverable.
